<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Consumer smoke test for Cortex.Mediator.SourceGenerator: a normal project that opts in to generation and
		exits non-zero unless the generated mediator dispatches correctly. Not part of Cortex.sln; run it with
		dotnet run, or publish it with -r win-x64 -p:SmokeMode=trimmed or -p:SmokeMode=aot to check those modes.
		SmokeMode is used instead of passing PublishTrimmed/PublishAot directly, because global properties also
		reach the referenced netstandard projects, which cannot be trimmed.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<InvariantGlobalization>true</InvariantGlobalization>
		<!-- Report every trim/AOT warning individually instead of one summary line per assembly. -->
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<!-- Both referenced projects copy a README.md to the output; only a project-reference artifact. -->
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	</PropertyGroup>

	<PropertyGroup Condition="'$(SmokeMode)' == 'trimmed'">
		<SelfContained>true</SelfContained>
		<PublishTrimmed>true</PublishTrimmed>
	</PropertyGroup>

	<PropertyGroup Condition="'$(SmokeMode)' == 'aot'">
		<PublishAot>true</PublishAot>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Cortex.Mediator\Cortex.Mediator.csproj" />
		<ProjectReference Include="..\..\src\Cortex.Mediator.SourceGenerator\Cortex.Mediator.SourceGenerator.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
